<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/halie-column.jpg">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><span>The Urban Sophisticate</span>Collective</a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/services/"{% if page.url == '/services/' %} aria-current="page"{% endif %}>Services</a>
      <a href="/lookbook/"{% if page.url == '/lookbook/' %} aria-current="page"{% endif %}>Lookbook</a>
      <a href="/notes/"{% if '/notes' in page.url %} aria-current="page"{% endif %}>Notes</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>Halie</a>
      <a class="btn small" href="/contact/">Book a consultation</a>
    </nav>
  </div>
</header>
<main id="main">{{ content | safe }}</main>
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <p class="foot-brand">The Urban Sophisticate Collective</p>
      <p class="foot-tag">Personal styling with a fresh approach. Cincinnati and Northern Kentucky, and by appointment.</p>
    </div>
    <div>
      <h3>Explore</h3>
      <a href="/services/">Services</a>
      <a href="/lookbook/">Lookbook</a>
      <a href="/notes/">Notes</a>
      <a href="/about/">About Halie</a>
      <a href="/contact/">Book a consultation</a>
    </div>
    <div>
      <h3>Follow</h3>
      <a href="{{ site.instagram }}">Instagram</a>
      <a href="{{ site.substack }}">The Urban Edit on Substack</a>
      <a href="{{ site.facebook }}">Facebook</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
  <div class="wrap foot-small">
    <span>&copy; {{ today | year }} The Urban Sophisticate Collective.</span>
    <span>Site by <a href="https://lickitysplitweb.com">Lickity Split Web Design</a>. <a href="/admin/">Sign in</a></span>
  </div>
</footer>
</body>
</html>
