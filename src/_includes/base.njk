<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>try{if(localStorage.getItem('uscDesktopView')==='1'){document.querySelector('meta[name="viewport"]').setAttribute('content','width=1280');document.documentElement.classList.add('desktop-view')}}catch(e){}</script>
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} · Personal Stylist and Wardrobe Consultant, Cincinnati{% endif %}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/og.png">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"LocalBusiness","name":"The Urban Sophisticate Collective","description":"Personal styling and wardrobe consulting in Cincinnati.","url":"{{ site.url }}","email":"{{ site.email }}","founder":{"@type":"Person","name":"Halie"},"areaServed":"Cincinnati, OH","sameAs":["{{ site.instagram }}","{{ site.substack }}",],"foundingDate":"2025-01-01","image":"{{ site.url }}/images/halie-lipstick-hero.jpg"}</script>
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><img src="/images/brand/lockup-horizontal.svg" alt="The Urban Sophisticate Collective" width="772" height="118"></a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/services/"{% if page.url == '/services/' or page.url == '/pricing/' %} aria-current="page"{% endif %}>Services</a>
      <a href="/events/"{% if page.url == '/events/' %} aria-current="page"{% endif %}>Events</a>
      <a href="/clients/"{% if page.url == '/clients/' %} aria-current="page"{% endif %}>Clients</a>
      <a href="/lookbook/"{% if page.url == '/lookbook/' %} aria-current="page"{% endif %}>Lookbook</a>
      <a href="/notes/"{% if '/notes' in page.url %} aria-current="page"{% endif %}>Notes</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>Halie</a>
      <a class="btn small" href="/contact/">Book a consultation</a>
    </nav>
  </div>
</header>
<main id="main">{{ content | safe }}</main>
{% if page.url != "/" and page.url != "/contact/" %}

<section class="band dark cta-band">
  <div class="wrap two-col">
    <div>
      <p class="kicker">Ready when you are</p>
      <h2>Be inspired by your own wardrobe.</h2>
      <p class="lede">A consultation with Halie is where it starts. Tell her what you're dressing for and what isn't working.</p>
      <div class="actions"><a class="btn" href="/contact/">Book a consultation</a><a class="btn ghost" href="/services/">How it works</a></div>
    </div>
    <img src="/images/green-sweater-close.jpg" alt="Halie in a green knit with tortoiseshell sunglasses and gold jewelry" width="1206" height="1507" loading="lazy">
  </div>
</section>
{% endif %}
<footer class="site-foot v2">
  <div class="wrap foot-top">
    <div class="fbrand">
      <a href="/" class="foot-logo-link" aria-label="The Urban Sophisticate Collective home"><img class="foot-logo" src="/images/brand/lockup-stacked-dark.svg" alt="The Urban Sophisticate Collective" width="420" height="236" loading="lazy"></a>
      
      <p class="foot-tag">Personal styling with a fresh approach. {{ site.territory }}, by appointment.</p>
      <div class="foot-ctas"><a class="btn" href="/contact/">Book a consultation</a><a class="btn ghost" href="/pricing/">Pricing</a></div>
    </div>
    <div class="fcol"><h3>Explore</h3><a href="/services/">Services</a><a href="/events/">Events and photoshoots</a><a href="/clients/">Clients</a><a href="/lookbook/">Lookbook</a><a href="/notes/">Notes</a><a href="/about/">About Halie</a></div><div class="fcol"><h3>The Urban Edit</h3><a href="{{ site.substack }}">Read on Substack</a><a href="/notes/fashion-week/">Fashion week notes</a><a href="/notes/black-to-an-event/">Unpopular opinions</a></div>
    <div class="fcol fcontact">
      <h3>Connect</h3>
      <a class="crow" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m3 7 9 6 9-6"/></svg><span>{{ site.email }}</span></a><span class="crow"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg><span>{{ site.territory }}</span></span>
      <div class="socials"><a class="soc" href="{{ site.instagram }}" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg></a><a class="soc" href="{{ site.substack }}" aria-label="Substack" title="Substack"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 3h18v2.6H3zM3 8.1h18v2.6H3zM3 13.2h18V21l-9-4.6L3 21z"/></svg></a></div>
    </div>
  </div>
  <div class="wrap foot-news">
    <div><p class="foot-brand">Get The Urban Edit</p><p class="foot-tag">What's next, what's loud, and what's worth wearing. Halie's newsletter on Substack.</p></div>
    <form class="news-form" action="{{ site.substack }}/subscribe" method="get" target="_blank"><label class="sr" for="nl-email">Email</label><input id="nl-email" type="email" name="email" placeholder="you@example.com" required><button class="btn" type="submit">Subscribe</button></form>
  </div>
  <div class="wrap foot-bottom">
    <span class="copy">&copy; {{ today | year }} The Urban Sophisticate Collective.</span>
    <span class="util"><a href="/admin/">Sign in</a><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a><button type="button" class="view-toggle" id="viewToggle">View desktop version</button><a class="totop" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m6 14 6-6 6 6"/></svg></a></span>
  </div>
</footer>
<script>(function(){var k='uscDesktopView',b=document.getElementById('viewToggle');if(!b)return;if(localStorage.getItem(k)==='1')b.textContent='View mobile version';b.addEventListener('click',function(){localStorage.setItem(k,localStorage.getItem(k)==='1'?'0':'1');location.reload()})})();</script>
</body>
</html>
