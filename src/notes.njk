---
layout: base.njk
title: Notes
permalink: /notes/
description: "Style tips, opinions, and Q&A from Halie."
---
<div class="wrap page-head"><h1>Notes</h1><p class="lede">Fashion tips, trends, opinions, and answers to your questions.</p></div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap notes">
  {%- for n in notes.notes %}
    <a class="note-card" href="/notes/{{ n.slug }}/"><img src="{{ n.image }}" alt="" loading="lazy"><p class="kicker">{{ n.kicker }}</p><h3>{{ n.title }}</h3></a>
  {%- endfor %}
  </div>
</section>
<section class="band paper">
  <div class="wrap">
    <div class="band-head"><h2>Who we follow</h2></div>
    <p class="lede" style="margin-bottom:2rem">{{ follows.intro }}</p>
    <div class="follows">
    {%- for f in follows.follows %}
      <a class="follow" href="{{ f.url }}"><span class="handle">@{{ f.handle }}</span><strong>{{ f.name }}</strong><p>{{ f.note }}</p></a>
    {%- endfor %}
    </div>
  </div>
</section>
